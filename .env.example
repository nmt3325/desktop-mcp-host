# Copy to .env and keep it out of git. Never commit real secrets.
# Public HTTPS origin reachable by MCP clients and your local PC agents.
PUBLIC_URL=https://mcp.example.com

# Shared secret used only by local agents when registering/reconnecting.
BROKER_SECRET=
# Bearer token used by ChatGPT / Notion / Claude for POST /mcp.
MCP_AUTH_TOKEN=

DESKTOP_MCP_IMAGE=ghcr.io/nmt3325/desktop-mcp-host:latest
BIND_ADDRESS=127.0.0.1
BROKER_PORT=8787
# Additional accepted Host headers, comma-separated (optional, include port).
ALLOWED_HOSTS=

AGENT_WAIT_SECONDS=50
EXEC_WORKERS=4
UNREACHABLE_LIMIT_SECONDS=600
MAX_OUTPUT_BYTES=268435456

# Legacy ephemeral-runner settings. They are ignored by persistent local agents
# and kept only so old deployments can transition without an immediate config rewrite.
DEFAULT_TTL_MINUTES=60
MAX_TTL_MINUTES=330
